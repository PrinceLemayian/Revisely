DATABASE_URL="postgresql://postgres:postgres@localhost:5432/revisely?schema=public"
# Direct (non-pooled) connection used only for `prisma migrate`.
# On Supabase/serverless, DATABASE_URL is the pooled URL (port 6543,
# add ?pgbouncer=true&connection_limit=1) and DIRECT_URL is the direct
# URL (port 5432). Locally you can set both to the same value.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/revisely?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret"

# Storage provider: "local", "s3", or "supabase"
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="./uploads"
# Used when STORAGE_PROVIDER="supabase" (server-side only; never expose the
# service-role key via NEXT_PUBLIC_*). Create the bucket in the Supabase dashboard.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="resources"
MAX_UPLOAD_BYTES="15728640"

# AI provider: "demo" (no network), "openai", or "groq"
AI_PROVIDER="demo"

# Used when AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Used when AI_PROVIDER="groq"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
# Optional Groq tuning (defaults shown)
GROQ_TEMPERATURE="0.2"
GROQ_MAX_TOKENS="2048"
GROQ_TOP_P="1"
# GROQ_REASONING_EFFORT="medium"   # low | medium | high (omit to disable)
GROQ_STREAM="false"                # "true" | "false"

APP_BASE_URL="http://localhost:3000"
